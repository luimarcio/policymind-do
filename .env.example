# Copie este arquivo para .env e preencha. NUNCA versione o arquivo .env.

# Chave da API de IA generativa (OpenAI ou provedor compatível com a API da OpenAI)
OPENAI_API_KEY=sk-coloque-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini
# Deixe vazio para usar a OpenAI
OPENAI_BASE_URL=
OPENAI_TIMEOUT=120

# Limite de caracteres do documento enviados ao LLM
# Planos gratuitos com limite de tokens por minuto (ex.: Groq, 8.000 TPM): use 16000
MAX_CHARS_LLM=120000

# Exemplo com Groq (configuração validada no projeto) — chave em https://console.groq.com
# OPENAI_API_KEY=gsk_sua-chave-aqui
# OPENAI_MODEL=openai/gpt-oss-120b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MAX_CHARS_LLM=16000

# Exemplo com Grok (xAI) — chave em https://console.x.ai
# OPENAI_API_KEY=xai-sua-chave-aqui
# OPENAI_BASE_URL=https://api.x.ai/v1

# OCR (Tesseract) — usado apenas para páginas sem texto e para imagens
OCR_ENABLED=true
OCR_LANG=por
# Windows: informe o caminho se o Tesseract não estiver no PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Se a IA falhar, faz extração mínima por regras (exibida como "SEM IA")
ALLOW_RULE_FALLBACK=true

# Cache/armazenamento estruturado em SQLite
CACHE_ENABLED=true
